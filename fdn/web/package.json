{
  "name": "@web2lan/fdn-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "type": "module",
  "description": "Access intranet web apps from any browser with an unchanged URL: Service Worker interception over a peer-to-peer WebRTC DataChannel, no intranet app changes.",
  "scripts": {
    "dev": "vite --port 5273 --host 127.0.0.1",
    "dev:stack": "bash ../../scripts/dev-stack.sh",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5273 --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node ../../scripts/e2e-port.mjs",
    "e2e:rtc": "node ../../scripts/e2e-webrtc.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}